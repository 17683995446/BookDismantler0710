# === LLM Provider API Keys (按需填写) ===
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
SILICONFLOW_API_KEY=
# Ollama 本地无需 key，只需确保服务运行在 OLLAMA_BASE_URL

# === Provider 端点（可选覆盖） ===
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OLLAMA_BASE_URL=http://localhost:11434/v1
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# === 应用配置 ===
BOOK_DISMANTLER_DEFAULT_PROVIDER=siliconflow
BOOK_DISMANTLER_DEFAULT_MODEL=Qwen/Qwen3-8B
BOOK_DISMANTLER_LOG_LEVEL=INFO
BOOK_DISMANTLER_OUTPUT_DIR=./output
BOOK_DISMANTLER_CHUNK_SIZE=2000
BOOK_DISMANTLER_CHUNK_OVERLAP=200
BOOK_DISMANTLER_MAX_CONCURRENT=4
