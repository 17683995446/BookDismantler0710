>     def _looks_like_chapter_title(line: str) -> bool:
>         """启发式判断一行是否为章节标题。
  
>         判定规则：
>             - 以「第X章」「第X节」开头
>             - 以「Chapter」开头
>             - 常见结构标题（前言/序言/目录/附录/后记/结语/参考文献）
>             - 全大写且长度 < 60
>         """
>         if not line or len(line) > 80:
